VITE_APP_WS_URL="ws://localhost:8080"
VITE_APP_BACKEND_URL="http://localhost:3000"

# Video call (WebRTC) - all optional. Defaults to Google's public STUN servers.
# VITE_APP_STUN_URLS="stun:stun.l.google.com:19302"
# TURN is needed for some networks in production. NOTE: VITE_ variables are
# public in the built JS - use short-lived credentials from your backend in prod.
# VITE_APP_TURN_URLS="turn:turn.example.com:3478"
# VITE_APP_TURN_USERNAME=""
# VITE_APP_TURN_CREDENTIAL=""
